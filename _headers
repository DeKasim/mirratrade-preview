# Regeln überschneiden sich bewusst nicht (Netlify fügt gleichnamige Header zusammen).
# CSS/JS werden per ?v=JJJJMMTT versioniert – bei Änderungen in allen HTML-Dateien hochzählen.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-G50p3OQJdzmNSHgmrckkRv9E5DVGNkEspwW0gLrWXBE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; form-action 'self' https:; frame-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-G50p3OQJdzmNSHgmrckkRv9E5DVGNkEspwW0gLrWXBE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https:; form-action 'self' https:; frame-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'
  Cache-Control: public, max-age=0, must-revalidate

